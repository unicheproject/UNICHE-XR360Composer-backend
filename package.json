{
  "name": "xr360-composer-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:storage": "tsx scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "archiver": "^7.0.1",
    "assimpjs": "^0.0.10",
    "fastify": "^5.7.4",
    "image-size": "^2.0.2",
    "jose": "^6.1.3",
    "minio": "^8.0.6",
    "mp4box": "^2.4.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
